{
  "name": "hsr-tools",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('pnpm/')) { console.error('Use pnpm for this project: corepack enable && pnpm install'); process.exit(1); }\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "icons:link": "tsx scripts/link-icons.ts",
    "icons:cloudflare": "tsx scripts/upload-cloudflare-images.ts",
    "sync:nanoka": "tsx scripts/sync-nanoka.ts && tsx scripts/link-icons.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@libsql/client": "latest",
    "drizzle-orm": "latest",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "latest",
    "drizzle-kit": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "5.9.3"
  }
}
